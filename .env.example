PGHOST=127.0.0.1
PGPORT=5432
PGUSER=jiangyu
PGDATABASE=personal_radar
PORT=4317
SYNC_INTERVAL_HOURS=4
# Optional: OpenAI-compatible endpoint for Chinese summaries of new feed items.
# Without a configured model, new items stay pending and are not published.
# SUMMARY_API_URL=https://api.openai.com/v1/chat/completions
# SUMMARY_API_KEY=
# SUMMARY_MODEL=

# Search capture defaults to the in-project collector and isolated Playwright Chromium.
# SEARCH_CHROMIUM_PATH=/absolute/path/to/chromium
SEARCH_DAILY_PAGE_LIMIT=300
# Set to 1 only when running the worker separately.
# SEARCH_WORKER_DISABLED=1

# Stable local API / agent CLI; tokens are created with `node bin/north.mjs auth create`.
# Outgoing Feishu notifications are disabled until the CLI, bot and recipient are configured.
NORTH_FEISHU_ENABLED=0
NORTH_NOTIFY_POLICY=important
# NORTH_FEISHU_CLI=/absolute/path/to/lark-cli
# NORTH_FEISHU_CHAT_ID=oc_your_authorized_group
# NORTH_INTEGRATION_WORKER_DISABLED=1
